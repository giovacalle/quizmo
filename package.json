{
	"name": "quizmo",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && vite build && bun scripts/inject-do-exports.mjs",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "playwright install && svelte-kit sync || echo ''",
		"check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"gen": "wrangler types"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.14.7",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.8.0",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^22",
		"bits-ui": "^2.16.3",
		"drizzle-kit": "^0.31.10",
		"drizzle-valibot": "^0.4.2",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"formsnap": "^2.0.1",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"sveltekit-superforms": "^2.30.0",
		"tailwind-variants": "^3.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"valibot": "^1.3.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.3",
		"wrangler": "^4.81.0"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.2.8",
		"better-auth": "^1.6.5",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"mode-watcher": "^1.1.0",
		"neverthrow": "^8.2.0",
		"resend": "^6.12.0",
		"runed": "^0.37.1",
		"svelte-sonner": "^1.1.0",
		"tailwind-merge": "^3.5.0",
		"zod": "^4.3.6"
	}
}
